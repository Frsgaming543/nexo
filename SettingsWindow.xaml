<Window x:Class="NexoIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexoIsland - Pengaturan" Width="500" Height="780" MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#FF0E1320" Foreground="White" FontFamily="Segoe UI" Icon="icon.ico">
    <Window.Resources>
        <!-- Saklar on/off. Content = judul, Tag = keterangan kecil (opsional) -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ContentPresenter/>
                                <TextBlock x:Name="Desc" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="11.5" Foreground="#FF8FA3C4" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border x:Name="Track" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Background="#33FFFFFF" Margin="14,0,0,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF2E7BFF"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Desc" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider warna (R / G / B) -->
        <Style x:Key="SldBlank" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SldFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SldThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="White" Stroke="#55000000" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sld" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="255"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SldFill}" Command="Slider.DecreaseLarge" Foreground="{TemplateBinding Foreground}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SldBlank}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SldThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Soft" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dark" TargetType="TextBox">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF151C2C"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Sec" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF8FA3C4"/>
            <Setter Property="Margin" Value="4,0,0,8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pratinjau island (ikut berubah langsung) -->
        <Border Grid.Row="0" Background="#FF06080F" Height="126">
            <Border x:Name="PvIsland" VerticalAlignment="Top" HorizontalAlignment="Center" Width="240" Height="82"
                    CornerRadius="0,0,30,30" BorderThickness="1">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="10" Height="15" CornerRadius="5" Background="#FF7FDBFF" Margin="0,0,12,0"/>
                        <Border Width="10" Height="15" CornerRadius="5" Background="#FF7FDBFF"/>
                    </StackPanel>
                    <TextBlock Text="Pratinjau island" FontSize="11" Foreground="#CCFFFFFF" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,6">

                <TextBlock Text="WARNA &amp; GRADIENT" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="SwGrad" Style="{StaticResource Switch}" Content="Gradient island" Tag="Dimatikan: island hitam polos"/>
                        <CheckBox x:Name="SwSong" Style="{StaticResource Switch}" Content="Ikuti warna cover lagu" Tag="Di halaman musik, warna island mengikuti sampul lagu"/>
                        <CheckBox x:Name="SwHalo" Style="{StaticResource Switch}" Content="Cahaya (glow) di bawah island"/>

                        <TextBlock Text="Warna utama" FontSize="12.5" FontWeight="SemiBold" Margin="0,14,0,8"/>
                        <StackPanel x:Name="Host1"/>

                        <Rectangle Height="1" Fill="#18FFFFFF" Margin="0,16,0,6"/>
                        <CheckBox x:Name="SwTwo" Style="{StaticResource Switch}" Content="Pakai 2 warna" Tag="Gradient dari warna utama ke warna kedua"/>
                        <StackPanel x:Name="Host2" Margin="0,8,0,6"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="TAMPILAN" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="SwSnow" Style="{StaticResource Switch}" Content="Salju" Tag="Salju turun di semua monitor, bisa didorong kursor"/>
                        <CheckBox x:Name="SwWinSnow" Style="{StaticResource Switch}" Content="Salju di jendela" Tag="Salju menumpuk di tepi atas jendela &amp; taskbar - sapu dengan kursor, klik untuk menyekop"/>
                        <CheckBox x:Name="SwIcons" Style="{StaticResource Switch}" Content="Ikon desktop Natal" Tag="Setiap ikon desktop memakai kostum Natal yang berbeda"/>
                        <CheckBox x:Name="SwBot" Style="{StaticResource Switch}" Content="Bot mata" Tag="Mata yang mengikuti kursor saat island tertutup"/>
                        <CheckBox x:Name="SwHat" Style="{StaticResource Switch}" Content="Topi Natal"/>
                        <CheckBox x:Name="SwTime" Style="{StaticResource Switch}" Content="Ikon waktu" Tag="Ikon pagi / siang / sore / malam di samping jam"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="NOTIFIKASI" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="SwNotif" Style="{StaticResource Switch}" Content="Aktifkan notifikasi island" Tag="Saklar utama untuk semua notifikasi di bawah"/>
                        <Rectangle Height="1" Fill="#18FFFFFF" Margin="0,8,0,4"/>
                        <StackPanel x:Name="NotifList">
                            <CheckBox x:Name="SwWifi" Style="{StaticResource Switch}" Content="WiFi"/>
                            <CheckBox x:Name="SwBt" Style="{StaticResource Switch}" Content="Bluetooth"/>
                            <CheckBox x:Name="SwPrayer" Style="{StaticResource Switch}" Content="Waktu shalat"/>
                            <CheckBox x:Name="SwBattery" Style="{StaticResource Switch}" Content="Baterai &amp; charger"/>
                            <CheckBox x:Name="SwCaps" Style="{StaticResource Switch}" Content="Caps Lock &amp; Num Lock"/>
                            <CheckBox x:Name="SwVol" Style="{StaticResource Switch}" Content="Volume &amp; mute"/>
                            <CheckBox x:Name="SwTerm" Style="{StaticResource Switch}" Content="Proses terminal" Tag="Penanda proses dotnet / node / python dkk. yang berjalan"/>
                            <CheckBox x:Name="SwFocus" Style="{StaticResource Switch}" Content="Sesi fokus" Tag="Timer di island saat tertutup + notifikasi selesai"/>
                            <CheckBox x:Name="SwXmas" Style="{StaticResource Switch}" Content="Hitung mundur Natal"/>
                            <CheckBox x:Name="SwCal" Style="{StaticResource Switch}" Content="Pengingat kalender" Tag="Ringkasan acara hari ini + pengingat saat jamnya tiba"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="JADWAL SHALAT" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="0,6,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Kota" FontSize="12" Foreground="#FF8FA3C4" Margin="0,0,0,5"/>
                                <TextBox x:Name="CityBox" Style="{StaticResource Dark}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Negara" FontSize="12" Foreground="#FF8FA3C4" Margin="0,0,0,5"/>
                                <TextBox x:Name="CountryBox" Style="{StaticResource Dark}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Soft}" Content="Terapkan" Click="ApplyCity_Click"/>
                            <TextBlock x:Name="CityNote" Foreground="#FF8FA3C4" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="MAINAN" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox x:Name="SwRoll" Style="{StaticResource Switch}" Content="Bola salju otomatis" Tag="Geser kursor kiri-kanan di atas tumpukan salju jendela: bola terbentuk di kursor. Klik mouse untuk melepas bola"/>
                        <TextBlock Foreground="#FF8FA3C4" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10"
                                   Text="Seret mainan dengan mouse; semua mainan bisa diletakkan di atas jendela (ikut bergerak bersama jendela). Klik buldoser = jalan/berhenti: pisaunya mendorong tumpukan salju sampai tepi jendela. Klik kereta Santa = terbang/mendarat. Klik kanan = hapus. Tumpuk bola salju (besar > sedang > kecil), lalu lepas mata/hidung/topi/syal/tangan/kancing di dekat bola untuk menempelkannya."/>
                        <WrapPanel>
                            <Button Style="{StaticResource Soft}" Tag="dozer" Content="Buldoser" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="sleigh" Content="Kereta Santa" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="tree" Content="Pohon Natal" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="gift" Content="Kado" Margin="0,0,8,8" Click="Toy_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Manusia salju (aksesori)" Foreground="#FF8FA3C4" FontSize="12" Margin="0,4,0,6"/>
                        <WrapPanel>
                            <Button Style="{StaticResource Soft}" Tag="eyes" Content="Mata" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="nose" Content="Hidung wortel" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="hat" Content="Topi" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="scarf" Content="Syal" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="arms" Content="Tangan" Margin="0,0,8,8" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="buttons" Content="Kancing" Margin="0,0,8,8" Click="Toy_Click"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource Soft}" Tag="set" Content="Satu set manusia salju" Margin="0,0,8,0" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="clear" Content="Hapus semua mainan" Click="Toy_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="LAMPU HIAS" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Foreground="#FF8FA3C4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Klik Lampu hias, lalu seret gulungannya. Lepas di dekat Pohon Natal = pohon menyala. Lepas di tepi atas sebuah jendela = ujung kabel terpasang di situ, lalu gerakkan kursor dan KLIK tepi atas jendela lain untuk mengaitkan ujung satunya (kabel menjuntai di antara dua jendela, ikut tertarik dan berayun saat jendela digeser; Esc / klik kanan = batal). Rangkai beberapa jendela dengan mengulang langkah ini. Untuk melepas: tahan Shift lalu klik kanan di kabelnya. Warna, pola, kecepatan, jarak, dan kendur kabel diatur di bawah ini."/>
                        <CheckBox x:Name="SwLink" Style="{StaticResource Switch}" Content="Kaitkan lampu antar jendela" Tag="Aktif: kabel dipasang dari satu jendela ke jendela lain. Nonaktif: lampu hanya di tepi atas satu jendela"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <Button Style="{StaticResource Soft}" Tag="lights" Content="Lampu hias" Margin="0,0,8,0" Click="Toy_Click"/>
                            <Button Style="{StaticResource Soft}" Tag="unlight" Content="Lepas semua lampu jendela" Click="Toy_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="LightHost"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="MODE MUSIK" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Foreground="#FF8FA3C4" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Tampilan layar penuh saat memutar musik: cover &amp; lirik besar yang bergerak, cahaya di tepi layar mengikuti warna cover dan berdenyut sesuai suara. Buka lewat tombol di bawah, tombol 🖥 di halaman musik island, atau klik kanan island. Di dalamnya: Esc = tutup, Spasi = putar/jeda, ← → = lagu sebelumnya/berikutnya, C = ganti lirik/cover, G = ganti mode cahaya, L = ganti mode lirik."/>
                        <Button Style="{StaticResource Soft}" Content="Buka Mode Musik" HorizontalAlignment="Left" Margin="0,0,0,6" Click="MusicMode_Click"/>
                        <CheckBox x:Name="SwMGlow" Style="{StaticResource Switch}" Content="Cahaya tepi layar" Tag="Gradasi &amp; bingkai neon berwarna cover di sekeliling layar"/>
                        <CheckBox x:Name="SwMClock" Style="{StaticResource Switch}" Content="Jam &amp; tanggal" Tag="Tampilkan jam di bagian atas layar Mode Musik"/>
                        <StackPanel x:Name="MusicHost"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="TENTANG" Style="{StaticResource Sec}"/>
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="0,4">
                        <TextBlock Text="NexoIsland" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Foreground="#FF8FA3C4" FontSize="12.5" Margin="0,2,0,0" Text="Dynamic island + salju Natal untuk Windows"/>
                        <TextBlock Margin="0,10,0,0" FontSize="13">
                            <Run Foreground="#FF8FA3C4" Text="Developer: "/><Run FontWeight="SemiBold" Text="class_programmer/farez"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FF0B0F1A" Padding="22,12">
            <Grid>
                <Button Style="{StaticResource Soft}" Content="Reset ke default" HorizontalAlignment="Left" Click="Reset_Click"/>
                <Button Style="{StaticResource Soft}" Content="Selesai" Background="#FF2E7BFF" HorizontalAlignment="Right" Padding="26,8" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
