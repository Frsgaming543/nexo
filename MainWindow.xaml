<Window x:Class="SnowIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Width="820" Height="330" Top="0">
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Tombol bulat (play / mulai) -->
        <Style x:Key="Round" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF0A1226"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Chip / pil: dipakai untuk segmented control, preset, aksi kecil -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- TextBox polos (tanpa latar) untuk kolom input bergaya pil -->
        <Style x:Key="Bare" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Dark" TargetType="TextBox">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Holder = kotak yang berubah ukuran (pegas); Halo = cahaya biru di bawah island -->
    <Grid x:Name="Holder" HorizontalAlignment="Center" VerticalAlignment="Top" Width="190" Height="48">
        <Border x:Name="Halo" IsHitTestVisible="False" VerticalAlignment="Bottom" Height="38" Margin="22,0,22,-28"/>

        <Grid x:Name="Island"
              MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" MouseLeftButtonDown="Island_Click"
              SizeChanged="Island_SizeChanged" LostKeyboardFocus="Island_LostFocus">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Pengaturan…" Click="Settings_Click"/>
                    <Separator/>
                    <MenuItem Header="Keluar" Click="Exit_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <Path x:Name="Bg" StrokeThickness="1"/>

            <Grid x:Name="Body" Margin="34,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="PageTitle" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White"
                               FontSize="16" FontWeight="Bold" FontFamily="Segoe UI Variable Display, Segoe UI" Visibility="Collapsed"/>

                    <!-- Bot: mata + topi Natal + properti (kopi, zzz, not musik) -->
                    <Grid x:Name="Bot" Width="130" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="Face">
                            <Grid.RenderTransform><TranslateTransform x:Name="Look"/></Grid.RenderTransform>
                            <StackPanel x:Name="Eyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12,0,0">
                                <Border x:Name="EyeL" Width="14" Height="20" CornerRadius="7" Background="#FF7FDBFF" Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="ScL"/></Border.RenderTransform>
                                </Border>
                                <Border x:Name="EyeR" Width="14" Height="20" CornerRadius="7" Background="#FF7FDBFF" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform><ScaleTransform x:Name="ScR"/></Border.RenderTransform>
                                </Border>
                            </StackPanel>

                            <!-- Topi Santa: ikut bergerak dengan wajah + ayunan fisika -->
                            <Canvas x:Name="Hat" Width="46" Height="26" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,1">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform x:Name="HatRot"/>
                                        <TranslateTransform x:Name="HatTr"/>
                                    </TransformGroup>
                                </Canvas.RenderTransform>
                                <Path Data="M5,21 C6,11 17,3 29,4 C36,9 40,15 42,21 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FFFF5C5C" Offset="0"/>
                                            <GradientStop Color="#FFC72626" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <Canvas Canvas.Left="29" Canvas.Top="4">
                                    <Canvas.RenderTransform><RotateTransform x:Name="PomRot"/></Canvas.RenderTransform>
                                    <Path Data="M0,0 C7,-1 12,3 13,10" Stroke="#FFD93636" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="8" Canvas.Top="6" Width="10" Height="10" Fill="#FFFDFEFF"/>
                                </Canvas>
                                <Border Canvas.Left="1" Canvas.Top="17" Width="44" Height="9" CornerRadius="4.5" Background="#FFF8FBFF"/>
                            </Canvas>
                        </Grid>

                        <Canvas x:Name="Props" Width="130" Height="48" IsHitTestVisible="False">
                            <Canvas x:Name="Cup" Canvas.Left="86" Canvas.Top="20" Width="24" Height="24" Opacity="0" RenderTransformOrigin="0.5,1">
                                <Canvas.RenderTransform><RotateTransform x:Name="CupTilt"/></Canvas.RenderTransform>
                                <Path x:Name="S1" Data="M0,0 C2.5,-2.5 -2.5,-5 0,-8" Stroke="#99FFFFFF" StrokeThickness="1.4" Canvas.Left="7" Canvas.Top="3"/>
                                <Path x:Name="S2" Data="M0,0 C2.5,-2.5 -2.5,-5 0,-8" Stroke="#99FFFFFF" StrokeThickness="1.4" Canvas.Left="12" Canvas.Top="3"/>
                                <Path x:Name="S3" Data="M0,0 C2.5,-2.5 -2.5,-5 0,-8" Stroke="#99FFFFFF" StrokeThickness="1.4" Canvas.Left="17" Canvas.Top="3"/>
                                <Path Data="M3,6 L19,6 L17.5,16 C17.2,19 15,21 12.5,21 L9.5,21 C7,21 4.8,19 4.5,16 Z" Fill="#FFFFF3E6"/>
                                <Ellipse Canvas.Left="3" Canvas.Top="4.8" Width="16" Height="3" Fill="#FF8B5A2B"/>
                                <Path Data="M19,8 C24,8 24,15 18,15" Stroke="#FFFFF3E6" StrokeThickness="2"/>
                            </Canvas>
                            <TextBlock x:Name="Z1" Text="z" FontSize="9"  FontWeight="Bold" Foreground="#FFAFC8FF" Opacity="0"/>
                            <TextBlock x:Name="Z2" Text="Z" FontSize="11" FontWeight="Bold" Foreground="#FFAFC8FF" Opacity="0"/>
                            <TextBlock x:Name="Z3" Text="Z" FontSize="13" FontWeight="Bold" Foreground="#FFAFC8FF" Opacity="0"/>
                            <TextBlock x:Name="N1" Text="♪" FontSize="13" Foreground="#FFFFC1E3" Opacity="0"/>
                            <TextBlock x:Name="N2" Text="♫" FontSize="13" Foreground="#FF7FDBFF" Opacity="0"/>
                            <TextBlock x:Name="Bang" Text="!" FontSize="15" FontWeight="Black" Foreground="#FFFFD27A" Opacity="0" Canvas.Left="98" Canvas.Top="8"/>
                        </Canvas>
                    </Grid>

                    <!-- Jam: ikon fase hari (malam / pagi / siang / sore + peralihan) + tanggal -->
                    <StackPanel x:Name="ClockBox" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Canvas x:Name="TimeIconCv" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel x:Name="ClockText" VerticalAlignment="Center">
                            <TextBlock x:Name="DateText" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PhaseText" Foreground="#FF9CC9F0" Opacity="0.9" FontSize="10.5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Kanan: equalizer, panah halaman sebelumnya / berikutnya, pengaturan -->
                    <StackPanel x:Name="HeadRight" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <StackPanel x:Name="Eq" Orientation="Horizontal" VerticalAlignment="Center" Height="22" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Ghost}" Width="28" Height="26" ToolTip="Sebelumnya" Click="PagePrev_Click">
                            <Path Data="M5,0 L0,5.5 L5,11" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Width="28" Height="26" ToolTip="Berikutnya" Click="PageNext_Click">
                            <Path Data="M0,0 L5,5.5 L0,11" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button Style="{StaticResource Ghost}" Content="⚙" FontSize="15" Width="28" Height="26" Opacity="0.75" ToolTip="Pengaturan" Click="Settings_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Panel (4 halaman) -->
                <Grid x:Name="Panel" Grid.Row="1" Margin="0,2,0,4" Visibility="Collapsed" Opacity="0">
                    <!-- Musik -->
                    <Grid x:Name="MusicPage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="100" Height="100" CornerRadius="14" VerticalAlignment="Top" Margin="0,0,18,0"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border.Background><ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock x:Name="TitleText" Text="Tidak ada musik" Foreground="White" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ArtistText" Foreground="#FFD5E6FA" Opacity="0.8" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="PosText" Text="00:00" Foreground="#FFE3EEFA" Opacity="0.8" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Grid x:Name="Track" Grid.Column="1" Height="16" VerticalAlignment="Center">
                                    <Border Height="4" CornerRadius="2" Background="#33FFFFFF"/>
                                    <Border x:Name="Fill" Height="4" CornerRadius="2" Background="White" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="RemText" Grid.Column="2" Foreground="#FFE3EEFA" Opacity="0.8" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Ghost}" Content="💬" FontFamily="Segoe UI Emoji" FontSize="16" HorizontalAlignment="Left" Click="Lyrics_Click"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource Ghost}" Content="⏮" Click="Prev_Click"/>
                                    <Button x:Name="PlayBtn" Style="{StaticResource Round}" Content="▶" Margin="6,0" Click="Play_Click"/>
                                    <Button Style="{StaticResource Ghost}" Content="⏭" Click="Next_Click"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="LyricsCol" Grid.Column="2" Width="290" Margin="22,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="L1" Foreground="White" Opacity="0.4" FontSize="15" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                            <TextBlock x:Name="L2" Foreground="White" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6" MaxHeight="76"/>
                            <TextBlock x:Name="L3" Foreground="White" Opacity="0.4" FontSize="15" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Shalat -->
                    <Grid x:Name="PrayerPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Canvas x:Name="ArcCanvas" Width="220" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SHALAT BERIKUTNYA" FontSize="10" FontWeight="SemiBold" Foreground="#FF9CC9F0" Opacity="0.85"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PrayerNext" Text="Memuat…" FontSize="30" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="PrayerAt" FontSize="15" Foreground="#FFD5E6FA" Opacity="0.8" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
                                </StackPanel>
                                <TextBlock x:Name="PrayerCount" FontFamily="Consolas" FontSize="19" Foreground="White"/>
                                <Grid x:Name="PrayerBarTrack" Height="4" Margin="0,8,0,0">
                                    <Border CornerRadius="2" Background="#33FFFFFF"/>
                                    <Border x:Name="PrayerBar" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                                </Grid>
                                <TextBlock x:Name="PrayerCity" FontSize="11" Foreground="#FF9CC9F0" Opacity="0.85" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="PrayerGrid" Grid.Row="1" Margin="0,6,0,0"/>
                    </Grid>

                    <!-- Fokus (Pomodoro) -->
                    <Grid x:Name="FocusPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Width="132" Height="132" VerticalAlignment="Center" Margin="4,0,28,0">
                            <Canvas Width="132" Height="132">
                                <Ellipse Canvas.Left="8" Canvas.Top="8" Width="116" Height="116" Stroke="#22FFFFFF" StrokeThickness="7"/>
                                <Path x:Name="FocusArc" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Ellipse x:Name="FocusKnob" Width="11" Height="11" Fill="White"/>
                            </Canvas>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="FocusTime" Text="25:00" FontSize="28" FontWeight="Light" FontFamily="Segoe UI Variable Display, Segoe UI"
                                           Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="FocusLabel" Text="FOKUS" FontSize="9.5" FontWeight="SemiBold" Foreground="#FF9CC9F0" HorizontalAlignment="Center"/>
                                <StackPanel x:Name="FocusDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border CornerRadius="16" Background="#14FFFFFF" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FocusSegWork" Style="{StaticResource Chip}" Content="🍅  Fokus" FontFamily="Segoe UI Emoji, Segoe UI" Width="112" Padding="0" Click="Focus_SegWork"/>
                                    <Button x:Name="FocusSegBreak" Style="{StaticResource Chip}" Content="☕  Istirahat" FontFamily="Segoe UI Emoji, Segoe UI" Width="112" Padding="0" Click="Focus_SegBreak"/>
                                </StackPanel>
                            </Border>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Chip}" Height="34" Padding="0" Background="#14FFFFFF" HorizontalContentAlignment="Stretch" Click="Focus_PickTask" ToolTip="Klik untuk ganti tugas yang difokuskan">
                                    <Grid Margin="12,0,12,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="🎯" FontFamily="Segoe UI Emoji" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FocusTaskText" Grid.Column="1" Margin="8,0" FontSize="13" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="›" FontSize="17" Foreground="#99FFFFFF" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="FocusTaskDone" Grid.Column="1" Style="{StaticResource Chip}" Content="✓" FontFamily="Segoe UI Symbol" FontSize="14"
                                        Width="34" Height="34" Padding="0" Margin="6,0,0,0" Background="#334ADE80" Visibility="Collapsed"
                                        ToolTip="Tandai tugas selesai" Click="Focus_TaskDone"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <StackPanel x:Name="FocusPresets" Orientation="Horizontal" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="FocusStats" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11.5" Foreground="#FF9CC9F0"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="FocusBtn" Style="{StaticResource Round}" Width="124" FontFamily="Segoe UI Symbol, Segoe UI" FontSize="14" FontWeight="SemiBold" Content="▶  Mulai" Click="Focus_Toggle"/>
                                <Button Style="{StaticResource Ghost}" Content="↺" Margin="8,0,0,0" ToolTip="Ulangi" Click="Focus_Reset"/>
                                <Button Style="{StaticResource Ghost}" Content="⏭" ToolTip="Lewati" Click="Focus_Skip"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- To-do -->
                    <Grid x:Name="TodoPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="146"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0">
                            <Grid Width="100" Height="100" HorizontalAlignment="Center">
                                <Canvas Width="100" Height="100">
                                    <Ellipse Canvas.Left="6" Canvas.Top="6" Width="88" Height="88" Stroke="#22FFFFFF" StrokeThickness="7"/>
                                    <Path x:Name="TodoArc" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                                <TextBlock x:Name="TodoPct" FontSize="24" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="TodoCount" FontSize="11.5" Foreground="#FF9CC9F0" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <Button x:Name="TodoClear" Style="{StaticResource Chip}" Content="Bersihkan selesai" FontSize="11" Height="22" Margin="0,6,0,0"
                                    Padding="10,0" HorizontalAlignment="Center" Visibility="Collapsed" Click="Todo_Clear"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border CornerRadius="18" Background="#1AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Height="36" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button x:Name="TodoPriBtn" Style="{StaticResource Ghost}" Width="34" Height="34" Click="Todo_Pri">
                                        <Ellipse x:Name="TodoPriDot" Width="12" Height="12"/>
                                    </Button>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="TodoBox" Style="{StaticResource Bare}" KeyDown="Todo_KeyDown" TextChanged="Todo_TextChanged"/>
                                        <TextBlock x:Name="TodoHint" Text="Tambah tugas baru…" IsHitTestVisible="False" Foreground="#88FFFFFF"
                                                   FontSize="13.5" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Grid.Column="2" Style="{StaticResource Round}" Content="+" FontFamily="Segoe UI" FontSize="19" Width="28" Height="28"
                                            Margin="0,0,3,0" Click="Todo_Add"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                <Grid>
                                    <StackPanel x:Name="TodoList"/>
                                    <TextBlock x:Name="TodoEmpty" Text="Belum ada tugas&#10;Mulai dari yang kecil ✨" TextAlignment="Center" Foreground="#99FFFFFF"
                                               FontSize="13" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Kalender -->
                    <Grid x:Name="CalendarPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                            <Grid Height="24">
                                <TextBlock x:Name="CalTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource Ghost}" Content="‹" FontFamily="Segoe UI" FontSize="18" Width="26" Height="22" ToolTip="Bulan sebelumnya" Click="Cal_Prev"/>
                                    <Button Style="{StaticResource Ghost}" Content="●" FontFamily="Segoe UI Symbol" FontSize="7" Width="20" Height="22" ToolTip="Hari ini" Click="Cal_Today"/>
                                    <Button Style="{StaticResource Ghost}" Content="›" FontFamily="Segoe UI" FontSize="18" Width="26" Height="22" ToolTip="Bulan berikutnya" Click="Cal_Next"/>
                                </StackPanel>
                            </Grid>
                            <UniformGrid x:Name="CalWeek" Columns="7" Height="16"/>
                            <UniformGrid x:Name="CalGrid" Columns="7" Rows="6" Height="120"/>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CalDayTitle" FontSize="16" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI Variable Display, Segoe UI" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="CalDaySub" FontSize="11.5" Foreground="#FF9CC9F0" Margin="0,1,0,0"/>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,8,0,6">
                                <Grid>
                                    <StackPanel x:Name="CalEvents"/>
                                    <TextBlock x:Name="CalEmpty" TextAlignment="Center" Foreground="#99FFFFFF" FontSize="12.5" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </Grid>
                            </ScrollViewer>
                            <Border Grid.Row="2" CornerRadius="17" Background="#1AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Height="34">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource Ghost}" Width="32" Height="32" ToolTip="Ganti warna acara" Click="Cal_Color">
                                        <Ellipse x:Name="CalColorDot" Width="12" Height="12"/>
                                    </Button>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="CalBox" Style="{StaticResource Bare}" FontSize="13" KeyDown="Cal_KeyDown" TextChanged="Cal_TextChanged"/>
                                        <TextBlock x:Name="CalHint" Text="Tambah acara…  cth: 19:30 Rapat" IsHitTestVisible="False" Foreground="#88FFFFFF"
                                                   FontSize="13" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Button Grid.Column="2" Style="{StaticResource Round}" Content="+" FontFamily="Segoe UI" FontSize="19" Width="26" Height="26"
                                            Margin="0,0,3,0" Click="Cal_Add"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Cuaca -->
                    <Grid x:Name="WeatherPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="4,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="WxIcon" Text="⛅" FontFamily="Segoe UI Emoji" FontSize="44" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WxTemp" Text="--°" FontSize="44" FontWeight="Light" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            </StackPanel>
                            <TextBlock x:Name="WxDesc" Text="Memuat cuaca…" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="WxCity" FontSize="11" Foreground="#FF9CC9F0" Margin="0,2,0,9" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="9" Background="#1AFFFFFF" Padding="7,3" Margin="0,0,5,0"><TextBlock x:Name="WxFeels" FontSize="10.5" Foreground="White" FontFamily="Segoe UI Emoji, Segoe UI"/></Border>
                                <Border CornerRadius="9" Background="#1AFFFFFF" Padding="7,3" Margin="0,0,5,0"><TextBlock x:Name="WxHum" FontSize="10.5" Foreground="White" FontFamily="Segoe UI Emoji, Segoe UI"/></Border>
                                <Border CornerRadius="9" Background="#1AFFFFFF" Padding="7,3"><TextBlock x:Name="WxWind" FontSize="10.5" Foreground="White" FontFamily="Segoe UI Emoji, Segoe UI"/></Border>
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid x:Name="WxDays" Grid.Column="1" Columns="5" VerticalAlignment="Center" Height="150"/>
                    </Grid>

                    <!-- Sistem -->
                    <Grid x:Name="SystemPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <UniformGrid x:Name="SysTiles" Columns="4" Height="98"/>
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border CornerRadius="16" Background="#1AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Margin="3,0,3,0" Padding="14,0">
                                <StackPanel VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="↓  Unduh" FontSize="11.5" Foreground="#FF9CC9F0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SysDown" Text="0 B/s" FontSize="13.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="↑  Unggah" FontSize="11.5" Foreground="#FF9CC9F0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SysUp" Text="0 B/s" FontSize="13.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="16" Background="#1AFFFFFF" BorderBrush="#16FFFFFF" BorderThickness="1" Margin="3,0,3,0" Padding="14,8">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="Aktivitas CPU" FontSize="11.5" Foreground="#FF9CC9F0"/>
                                        <TextBlock x:Name="SysUptime" FontSize="11.5" Foreground="#FF9CC9F0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Canvas x:Name="SysSpark" Grid.Row="1" Height="34" VerticalAlignment="Bottom" ClipToBounds="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Dock navigasi halaman (dibangun di kode) -->
                <StackPanel x:Name="Tabs" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="0,0,0,8" Visibility="Collapsed"/>
            </Grid>

            <!-- Lapisan ramping: lirik / notifikasi / terminal / fokus -->
            <Grid IsHitTestVisible="False">
                <TextBlock x:Name="SlimLyric" Opacity="0" Visibility="Collapsed" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           MaxWidth="400" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <StackPanel x:Name="ToastPanel" Orientation="Horizontal" Opacity="0" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Border x:Name="ToastBadge" Width="34" Height="34" CornerRadius="17" Background="#FF2E9BFF">
                        <TextBlock x:Name="ToastIcon" FontFamily="Segoe UI Emoji" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" Foreground="White" FontSize="14" FontWeight="SemiBold" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ToastSub" Foreground="#FF9CC9F0" FontSize="11.5" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <!-- HUD: volume (dengan bar), mute, Caps Lock, Num Lock -->
                <StackPanel x:Name="HudPanel" Orientation="Horizontal" Opacity="0" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Border x:Name="HudBadge" Width="34" Height="34" CornerRadius="17" Background="#FF2E9BFF">
                        <Canvas x:Name="HudIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="172">
                        <TextBlock x:Name="HudTitle" Foreground="White" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Grid x:Name="HudBarHost" Height="5" Margin="0,6,0,0" HorizontalAlignment="Left" Width="172">
                            <Border CornerRadius="2.5" Background="#33FFFFFF"/>
                            <Border x:Name="HudBar" CornerRadius="2.5" Background="White" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <TextBlock x:Name="HudSub" Foreground="#FF9CC9F0" FontSize="11.5" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="HudValue" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextAlignment="Right" Width="50" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="TermPanel" Orientation="Horizontal" Opacity="0" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Ellipse x:Name="D1" Width="7" Height="7" Fill="#FF5BE38B" Margin="0,0,4,0"/>
                    <Ellipse x:Name="D2" Width="7" Height="7" Fill="#FF5BE38B" Margin="0,0,4,0"/>
                    <Ellipse x:Name="D3" Width="7" Height="7" Fill="#FF5BE38B"/>
                    <TextBlock x:Name="TermText" Foreground="White" FontFamily="Consolas" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="FocusPanel" Orientation="Horizontal" Opacity="0" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Grid Width="26" Height="26">
                        <Ellipse Margin="3" Stroke="#33FFFFFF" StrokeThickness="3"/>
                        <Path x:Name="FocusMiniArc" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <TextBlock x:Name="FocusText" Foreground="White" FontFamily="Segoe UI Variable Display, Consolas" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FocusMini" Foreground="#FF9CC9F0" FontSize="12" Margin="10,0,0,0" MaxWidth="110"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
